# Local values come from `pnpm --filter @pyq/db db:start` (API URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Postgres connection for Prisma (local: from `db:start`, port 54322).
# Queries still run under RLS via withCaller(); see docs/decisions/0004.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Path to LibreOffice's soffice, used to convert Word/PowerPoint uploads to PDF.
# Usually not needed: default install locations and PATH are checked. See README "Uploads".
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
