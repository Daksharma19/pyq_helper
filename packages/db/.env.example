# Copy to .env (gitignored).
# Prisma (db:pull, integration tests). Local: Supabase Postgres from `db:start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hosted Supabase seeding (seed:hosted). Server-side only.
# Project Settings -> Database -> Connection string -> URI ("Session pooler").
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Project Settings -> API.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
