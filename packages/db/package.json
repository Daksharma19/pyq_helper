{
  "name": "@pyq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:start": "supabase start --workdir .",
    "db:stop": "supabase stop --workdir .",
    "db:reset": "supabase db reset --workdir .",
    "seed:pdfs": "node scripts/make-sample-pdfs.mjs",
    "db:pull": "prisma db pull && prisma format && prisma generate",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:deploy": "node --env-file=.env scripts/deploy-hosted.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@pyq/shared": "workspace:*",
    "@supabase/supabase-js": "^2.58.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@pyq/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "eslint": "^9.36.0",
    "pdf-lib": "^1.17.1",
    "prisma": "7.10.0",
    "supabase": "^2.118.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
