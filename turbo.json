{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY", "DATABASE_URL", "TEST_DATABASE_URL"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["db:generate", "^db:generate"] },
    "typecheck": { "dependsOn": ["db:generate", "^db:generate"] },
    "test": { "dependsOn": ["db:generate", "^db:generate"] },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^db:generate"] }
  }
}
